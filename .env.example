# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL Connection Configuration
# Format: postgresql://username:password@157.9.183.151:5432/tanaka_vms
DATABASE_URL="postgresql://vms_user:vms_password_123@157.9.183.151:5432/tanaka_vms"
PGHOST="157.9.183.151"
PGPORT="5432"
PGUSER="vms_user"
PGPASSWORD="vms_password_123"
PGDATABASE="tanaka_vms"